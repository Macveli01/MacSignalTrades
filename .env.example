# Required to accept TradingView webhook requests
TRADINGVIEW_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Telegram publishing (keep server-side; never use NEXT_PUBLIC_ prefix)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PUBLISH_SECRET=replace-with-a-long-random-secret

# Keep false until real market data and channel delivery have been tested
AUTO_PUBLISH=false

# Supabase persistence + duplicate protection
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
